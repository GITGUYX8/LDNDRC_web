    {
      "id": "foundations",
      "name": "Foundations",
      "color": "#b8bb26",
      "blurb": "What the platform is, who it is for, and the constraint that shaped every other decision."
    },
    {
      "id": "cluster",
      "name": "Cluster",
      "color": "#458588",
      "blurb": "K3s on laptops, the local demo, and the networking that carries traffic."
    },
    {
      "id": "compute",
      "name": "Compute",
      "color": "#8ec07c",
      "blurb": "Which laptops may contribute resources, and how a consumer GPU is shared."
    },
    {
      "id": "sessions",
      "name": "Sessions",
      "color": "#d3869b",
      "blurb": "One private, isolated ROS workspace per student, provisioned on demand."
    },
    {
      "id": "workspace",
      "name": "Workspace",
      "color": "#fe8019",
      "blurb": "The three browser tools: editor, desktop, and the streaming simulator."
    },
    {
      "id": "join",
      "name": "Join",
      "color": "#fabd2f",
      "blurb": "How a new laptop announces itself, asks for approval, and becomes a Host."
    },
    {
      "id": "experience",
      "name": "Experience",
      "color": "#83a598",
      "blurb": "The student-facing shell that wraps the tools into one product."
    },
    {
      "id": "direction",
      "name": "Direction",
      "color": "#fb4934",
      "blurb": "The stack, the history, and what is still left to build."
    }
  ],
  "goals": [
    {
      "id": "goal-demo",
      "title": "Demo it on one laptop",
